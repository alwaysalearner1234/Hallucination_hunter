{
  "name": "Hallucination Hunter",
  "short_name": "HH Verify",
  "description": "Verify AI responses claim-by-claim with real evidence. Right-click any AI response to fact-check it.",
  "version": "1.0.0",
  "manifest_version": 3,
  "author": "TruthLayer",
  "homepage_url": "https://truthlayer.example.com",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Hallucination Hunter",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.truthlayer.example.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["src/content/adapters/chatgpt.js"],
      "css": ["assets/styles/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/adapters/claude.js"],
      "css": ["assets/styles/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://gemini.google.com/*", "https://bard.google.com/*"],
      "js": ["src/content/adapters/gemini.js"],
      "css": ["assets/styles/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": ["src/content/adapters/perplexity.js"],
      "css": ["assets/styles/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/*.png", "assets/styles/*.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}