# ============================================================
# Hallucination Hunter — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── LLM (Google Gemini) ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Alternatively use OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER=openai   # or: gemini (default)

# ── Evidence Retrieval (Tavily) ──────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=hh_user
POSTGRES_PASSWORD=hh_password
POSTGRES_DB=hallucination_hunter
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hh_user:hh_password@localhost:5432/hallucination_hunter

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200
# Per-install API keys: keep false locally, true on staging/prod
REQUIRE_API_KEY=false

# ── Backend ───────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:8081,exp://localhost:8081
APP_ENV=development
LOG_LEVEL=INFO

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_ENABLED=true
MAX_INPUT_LENGTH=50000
MAX_FILE_SIZE_MB=10

# ── Agent ─────────────────────────────────────────────────────
MAX_RETRIEVAL_ITERATIONS=3
MAX_SOURCES_PER_CLAIM=5
AGENT_TIMEOUT_SECONDS=120
# Parallel claim verification + per-claim budget
MAX_CLAIM_CONCURRENCY=4
CLAIM_TIMEOUT_SECONDS=90
# Downstream timeouts
SEARCH_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=60
