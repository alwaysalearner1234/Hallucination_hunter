# Production secrets — copy to .env.prod and fill in. NEVER commit .env.prod.
POSTGRES_USER=hh_user
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=hallucination_hunter
REDIS_PASSWORD=CHANGE_ME_long_random_password
GEMINI_API_KEY=AIza...your_key_here
TAVILY_API_KEY=tvly-...your_key_here
JWT_SECRET=CHANGE_ME_long_random_secret_min_32_chars
# Extension MV3 origins are covered by allow_origin_regex in code; add explicit
# dashboard/dev origins here if needed (comma-separated):
BACKEND_CORS_ORIGINS=*
# Error tracking (empty = off, but prod SHOULD set it):
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
